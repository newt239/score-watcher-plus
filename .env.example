# アプリのバージョン（アップデート告知モーダルの表示判定に使用）
NEXT_PUBLIC_APP_VERSION=
# アプリの公開URL（本番は https://plus.score-watcher.com）。認証のbaseURL・信頼するオリジンの決定に使用
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_TAG_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Google OAuth（リダイレクトURIに ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google を登録すること）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BETTER_AUTH_SECRET=
# 観戦モードのボードキャッシュに使用するCloudflare KV
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_API_TOKEN=

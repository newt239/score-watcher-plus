{
  "name": "score-watcher",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "codecheck": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run stylelint && pnpm run ls-lint && pnpm run knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbo",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "gen": "cmk",
    "knip": "knip",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "ls-lint": "ls-lint",
    "playwright": "playwright test",
    "preinstall": "npx only-allow pnpm",
    "setup": "corepack enable pnpm",
    "start": "next start",
    "stylelint": "stylelint \"./**/*.css\" --ignore-path .gitignore",
    "stylelint:fix": "stylelint \"./**/*.css\" --ignore-path .gitignore --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vitest": "vitest",
    "vitest:ui": "vitest --ui"
  },
  "dependencies": {
    "@hello-pangea/dnd": "18.0.1",
    "@libsql/client": "0.17.4",
    "@mantine/core": "9.4.2",
    "@mantine/dropzone": "9.4.2",
    "@mantine/form": "9.4.2",
    "@mantine/hooks": "9.4.2",
    "@mantine/modals": "9.4.2",
    "@mantine/notifications": "9.4.2",
    "@next/third-parties": "16.2.11",
    "@sentry/nextjs": "10.67.0",
    "@tabler/icons-react": "3.45.0",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "1.6.24",
    "boring-avatars": "2.0.4",
    "cdate": "0.0.7",
    "drizzle-orm": "0.45.2",
    "encoding-japanese": "2.2.0",
    "hono": "4.12.31",
    "nanoid": "6.0.0",
    "next": "16.2.11",
    "nuqs": "2.9.1",
    "postcss-preset-mantine": "1.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@css-modules-kit/codegen": "1.4.0",
    "@css-modules-kit/stylelint-plugin": "1.4.0",
    "@hono/zod-validator": "0.9.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@playwright/test": "1.61.1",
    "@types/encoding-japanese": "2.2.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/ui": "4.1.10",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "import-in-the-middle": "3.3.2",
    "jsdom": "29.1.1",
    "knip": "6.29.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "8.5.22",
    "require-in-the-middle": "8.0.1",
    "stylelint": "17.14.1",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"

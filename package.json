{
  "name": "score-watcher",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "codecheck": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run stylelint && pnpm run ls-lint && pnpm run knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "react-router dev",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "gen": "cmk",
    "knip": "knip",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "ls-lint": "ls-lint",
    "playwright": "playwright test",
    "preinstall": "npx only-allow pnpm",
    "preview": "pnpm run build && wrangler dev",
    "stylelint": "stylelint \"./**/*.css\" --ignore-path .gitignore",
    "stylelint:fix": "stylelint \"./**/*.css\" --ignore-path .gitignore --fix",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc --noEmit",
    "vitest": "vitest",
    "vitest:ui": "vitest --ui"
  },

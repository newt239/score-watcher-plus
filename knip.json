{
  "$schema": "./node_modules/knip/schema.json",
  "ignore": ["drizzle.config.ts"],
  "ignoreDependencies": [
    "@css-modules-kit/stylelint-plugin",
    "@typescript/native-preview",
    "dotenv",
    "import-in-the-middle",
    "require-in-the-middle",
    "lefthook",
    "postcss-load-config"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  },
  "drizzle": false
}

{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreBinaries": ["mise"],
  "ignoreDependencies": [
    "@css-modules-kit/stylelint-plugin",
    "@typescript/native-preview",
    "dotenv",
    "lefthook",
    "postcss-load-config",
    "@react-router/node",
    "cloudflare"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}

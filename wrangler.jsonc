{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "score-watcher-plus",
  "main": "workers/app.ts",
  "compatibility_date": "2026-07-24",
  // better-auth / drizzle / @libsql/client がNode.js APIを参照するため必須
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "build/client",
  },
  "observability": {
    "enabled": true,
  },
  // 本番のカスタムドメイン。DNSレコードはwranglerが自動で作成する
  "routes": [
    {
      "pattern": "plus.score-watcher.com",
      "custom_domain": true,
    },
  ],
  // 観戦モードのボードキャッシュ。従来はREST API経由だったがネイティブバインディングに変更した
  "kv_namespaces": [
    {
      "binding": "BOARD_CACHE",
      "id": "a6cf5d0e187f4d7e8e1b86bb306195a6",
    },
  ],
}
